#!/usr/bin/env bash
set -euo pipefail

if ! nix flake info &>/dev/null; then
  echo "This environment needs Nix flakes edition" >&2
  exit 1
fi

watch_file flake.lock
watch_file flake.nix
watch_file pkgs/zarf-ansible-modules/package.nix
mkdir -p "$(direnv_layout_dir)"

# A `nix build` leaves the module files here, which is what the e2e suites and a hand-run module
# want on PATH. build/ is where mage puts them instead; both are gitignored.
PATH_add result/bin

use flake .
